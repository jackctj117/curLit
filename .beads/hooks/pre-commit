#!/usr/bin/env sh
# CL-90b0: explicit canonical-store export, safe in linked worktrees.
# The generic bd hook staged issues.jsonl at the worktree root. Export failure
# must fail the commit; never silently publish without the canonical tracker.
set -eu
if ! command -v bd >/dev/null 2>&1; then
    echo >&2 'beads: bd is required before committing'
    exit 1
fi
_worktree=$(git rev-parse --show-toplevel)
_common=$(git rev-parse --path-format=absolute --git-common-dir)
_primary=$(dirname "$_common")
_store="$_primary/.beads/embeddeddolt"
if [ ! -d "$_store" ]; then
    echo >&2 'beads: canonical store unavailable; refusing ambiguous export'
    exit 1
fi
(
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
    cd "$_primary"
    bd --sandbox --db "$_store" export --output "$_worktree/.beads/issues.jsonl"
)
git -C "$_worktree" add -- .beads/issues.jsonl
