# Project data directories — runtime artifacts, never source.
# Anchored with leading slash so this only matches the top-level
# ``data/`` runtime tree, not ``src/data/`` which is data-ingester
# source code (CL-3t4j surfaced this conflict — adding a new file
# under src/data/ was blocked by the unanchored pattern).
/data/

# Models (artifacts)
models/**/pytorch_model*.bin
models/**/*.safetensors
models/**/*.h5
models/**/optimizer.pt
models/**/scheduler.pt
!models/cb-sentiment-v1/.gitkeep

# Logs
logs/
*.log

# Docker
docker-compose.override.yml

# Airflow
airflow/logs/
airflow/plugins/

# OS
Thumbs.db

# Obsidian knowledge-graph vault (CL-uuy0) — regeneratable build artifacts.
# The exporter + hand-authored seed concepts are committed; the generated
# vault and the staleness manifest are not (rebuild with `make knowledge-vault`).
knowledge/obsidian/vault/
knowledge/obsidian/.manifest.json
