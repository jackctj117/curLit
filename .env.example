# curLit environment configuration (CL-oluv)
# Copy to .env and fill in values:  cp .env.example .env
# Every var the code or compose files read is listed here. Blank/placeholder
# values are safe defaults — the engine degrades gracefully without them.

# ── Environment ──────────────────────────────────────────────────────────
FX_ENV=development                # deployment label (reserved; not parsed by code yet)
LOG_LEVEL=INFO                    # log verbosity label (reserved; logging_setup uses INFO)
FX_CONFIG=configs/live_portfolio.yaml   # engine portfolio config path
FX_LOG_DIR=logs                   # engine log directory
#FX_EDGE_REPORT_DIR=reports/edge  # edge-testing report output dir (optional)
CURLIT_RISK_PROFILE=              # override active risk profile (see configs/risk_profile.yaml)

# ── Database (Postgres/TimescaleDB) ──────────────────────────────────────
POSTGRES_HOST=localhost           # DB host ("postgres" inside compose network)
POSTGRES_PORT=5432                # DB port
POSTGRES_DB=fx                    # database name
POSTGRES_USER=fx                  # database user
POSTGRES_PASSWORD=change-me       # database password
#DATABASE_URL=                    # full SQLAlchemy URL; overrides the POSTGRES_* parts if set

# ── Engine network (CL-oluv env-overridable; defaults shown) ─────────────
CURLIT_API_PORT=8200              # embedded web API port
CURLIT_METRICS_PORT=8099          # prometheus metrics port
#CURLIT_API_HOST=127.0.0.1        # web API bind address (compose sets 0.0.0.0 in-container)
WEB_API_SECRET=change-me-to-a-random-string   # shared secret for /api/* routes (/health is open)
#SOAK_DASHBOARD_PORT=8201         # scripts/soak_dashboard.py listen port

# ── Broker — OANDA ───────────────────────────────────────────────────────
OANDA_API_KEY=your-oanda-api-key          # OANDA v20 token
OANDA_ACCOUNT_ID=your-oanda-account-id    # OANDA account id
BROKER_MODE=paper                 # compose engine mode: paper|oanda-practice|oanda-live|polymarket-*

# ── Broker — Polymarket (optional; needs pip extra [polymarket]) ─────────
#VAULT_PATH=                      # encrypted key-vault path (preferred over env keys)
#VAULT_SALT=                      # vault KDF salt
#POLYMARKET_ALLOW_ENV_FALLBACK=   # set 1 to allow env-var keys instead of the vault (dev only)
#POLYMARKET_MAINNET_UNLOCK=       # HARD GATE — set 1 only after CL-poly-3 acceptance

# ── Broker — IBKR (parked, future) ───────────────────────────────────────
#IBKR_HOST=127.0.0.1
#IBKR_PORT=7497
#IBKR_CLIENT_ID=1

# ── Data APIs ────────────────────────────────────────────────────────────
FRED_API_KEY=your-fred-api-key    # FRED macro series ingestion
ENTSOE_API_TOKEN=                 # ENTSO-E power data (alt-data ingestion; optional)
#TWITTER_BEARER_TOKEN=            # X API v2 basic tier (PAID) — social ingest + activates scripts/x_monitor.py (idles without it)
#REDDIT_CLIENT_ID=                # social ingest via PRAW (optional)
#REDDIT_CLIENT_SECRET=            # social ingest via PRAW (optional)

# ── X watchlist monitor (CL-3j86; scripts/x_monitor.py) ──────────────────
# Ships dark until TWITTER_BEARER_TOKEN (above) is provisioned. Never scrapes.
#X_MONITOR_MONTHLY_CAP=9000       # monthly X API read budget for the governor (default 9000)
#X_MONITOR_BACKEND=api            # api (official, default) | cli (external tool — ToS/ban risk, see below)
#X_MONITOR_CLI_CMD=               # cli backend command template, e.g. 'bird user-tweets {handle} -n 4 --json'.
#                                 # WARNING: cookie-based CLI tools violate X ToS; ban risk attaches to the
#                                 # cookie account — burner account only. See CliTransport in src/data/x_monitor.py.
# CL-esyo — the monitor FEEDS THE ANALYSIS PIPELINE, not just Telegram. Relevant posts
# (those keyword-matching a playbook watch_term; small_traders category excluded) become
# NEW geo_events rows the Event Impact Agent assesses — exactly like GDELT headlines.
#X_MONITOR_INGEST=on              # DEFAULT ON. X posts → geo_events → impact agent (needs POSTGRES_* / DATABASE_URL).
#X_MONITOR_FORWARD=off            # DEFAULT OFF. Raw tweet relay to Telegram — opt-in now that ingestion is the point.

# ── LLM providers (research pipeline) ────────────────────────────────────
# NOTE: the research pipeline normally runs through the claude-code CLI on
# the operator's subscription — ANTHROPIC_API_KEY is only the fallback
# API-billed provider path (src/research/llm/client.py).
ANTHROPIC_API_KEY=
#DEEPSEEK_API_KEY=                # optional/parked alternate provider
#XAI_API_KEY=                     # optional/parked alternate provider (Grok)
#EVENT_IMPACT_MODEL=              # model override for scripts/event_pipeline.py
# Fast triage tier (CL-cunh): a cheap Haiku batch pre-filter that DISMISSES
# clearly-irrelevant events before the expensive full assessment. Opt-in;
# fails open (a triage outage escalates everything, never drops a real event).
#EVENT_TRIAGE_ENABLED=1           # turn the triage pre-filter on (default off)
#EVENT_TRIAGE_MIN_RELEVANCE=4     # 0-10; only events below this are skipped
#EVENT_TRIAGE_MODEL=claude-haiku-4-5-20251001   # fast tier model override
#NICHE_MIN_URGENCY=7              # urgency floor for the niche agent (CL-u2ph)
#NICHE_MAX_CYCLES=2               # iterative hopping depth, 1-5 (CL-2dnf); each
                                  # extra cycle = 1 more subscription call/event
#NICHE_TOOLS_ENABLED=1            # ground hops in real SEC filings + profiles
                                  # (CL-2czc); only meaningful with cycles > 1
#NICHE_TOOLS_MAX_ENTITIES=2       # names grounded per cycle (bounds SEC calls)
# Agentic Kimi tool-loop (CL-ddzt): the MODEL drives the SEC/ticker tools
# mid-generation. API-BILLED (Moonshot), opt-in; replaces the subscription
# cycles for the niche pass when enabled. Needs MOONSHOT_API_KEY.
#NICHE_TOOL_AGENT_ENABLED=1
#MOONSHOT_API_KEY=sk-...           # Moonshot AI (Kimi) API key
#KIMI_MODEL=kimi-k3                # flagship; requires temperature=1
#KIMI_MAX_ITERATIONS=8            # tool-loop budget per event
# Adversarial red-team critic (CL-3v56): a claude-code (free) skeptic attacks
# each surviving niche idea; refuted ones are dropped, survivors carry the
# bear case. Independent of the generator, so it works well with Kimi.
#NICHE_CRITIC_ENABLED=1
#NICHE_CRITIC_MODEL=claude-sonnet-4-6

# ── Reddit monitoring (CL-okww) ──────────────────────────────────────────
# Tiered subreddit poller feeding geo_events (scripts/reddit_monitor.py).
# Reddit 403-blocks keyless JSON scraping, so create a free "script" app at
# https://www.reddit.com/prefs/apps and set:
#REDDIT_CLIENT_ID=...
#REDDIT_CLIENT_SECRET=...
#REDDIT_USER_AGENT=curlit-event-monitor/1.0 by u/YourUsername

# ── Alpaca paper options auto-execution (CL-ldd2) ────────────────────────
# Auto-buys red-team-survived niche options ideas on Alpaca PAPER. Separate
# from the Telegram advisory feed. scripts/execute_options.py --loop 300.
#ALPACA_API_KEY=PK...
#ALPACA_API_SECRET=...
#ALPACA_PAPER=true
#ALPACA_OPTIONS_ENABLED=1          # master switch (refuses to trade if unset)
#ALPACA_OPT_MIN_CONFIDENCE=0.55    # idea confidence floor
#ALPACA_OPT_MAX_PREMIUM=500        # skip a contract whose premium exceeds this
#ALPACA_OPT_QTY=1                  # contracts per idea
#ALPACA_OPT_MAX_PER_DAY=5          # hard daily cap on new option orders
#ALPACA_OPT_MIN_ALIGNMENT=-0.4     # skip ideas whose computed technicals
                                   # score below this vs the thesis (CL-3xoj)
# SEC EDGAR name enrichment (CL-9xha) — declare your contact so SEC's edge
# doesn't rate-limit scripts/refresh_symbols.py (must stay browser-shaped).
#SEC_EDGAR_USER_AGENT=Mozilla/5.0 (curLit research; you@example.com)

# ── Alerting (Telegram is the sole operator channel) ─────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token    # notifications + alertmanager
TELEGRAM_CHAT_ID=your-telegram-chat-id        # target chat for alerts
#EVENT_DIGEST_MIN_URGENCY=5       # event-scan digest urgency threshold

# ── Observability stack (compose --profile full) ─────────────────────────
GRAFANA_ADMIN_USER=admin          # Grafana login
GRAFANA_ADMIN_PASSWORD=admin      # Grafana password — change for anything non-local

# ── Airflow (compose --profile full) ─────────────────────────────────────
AIRFLOW_DB_PASSWORD=airflow       # airflow metadata DB password
AIRFLOW_ADMIN_PASSWORD=admin      # airflow web UI admin password
AIRFLOW_SECRET_KEY=change-me-to-random    # webserver session secret
