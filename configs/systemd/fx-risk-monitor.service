# curLit — independent risk monitor
# Copy to /etc/systemd/system/fx-risk-monitor.service
# Enable: systemctl enable fx-risk-monitor

[Unit]
Description=curLit Risk Monitor Service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fx
Group=fx
WorkingDirectory=/opt/fx-system
Environment="PYTHONPATH=/opt/fx-system"
Environment="FX_ENV=production"
EnvironmentFile=/opt/fx-system/.env

ExecStart=/opt/fx-system/venv/bin/python -m src.ops.risk_monitor
ExecStop=/bin/kill -SIGTERM $MAINPID

Restart=on-failure
RestartSec=15s
StartLimitInterval=300
StartLimitBurst=5

LimitNOFILE=65536
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fx-risk-monitor

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/fx-system/logs

[Install]
WantedBy=multi-user.target
